{
  "mcpServers": {
    "linear-predator": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp", "22305"],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/linear-predator"
      }
    },
    "notion-predator": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.notion.com/mcp", "22306"],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/notion-predator"
      }
    },
    "revenuecat-predator": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.revenuecat.ai/mcp", "22307"],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/revenuecat-predator"
      }
    },
    "posthog-predator": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.posthog.com/mcp", "22308"],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/posthog-predator"
      }
    }
  }
}
