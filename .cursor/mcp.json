{
  "mcpServers": {
    "linear-predator": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp",
        "22227"
      ],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/linear-predator"
      }
    },
    "notion-predator": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.notion.com/mcp",
        "22233"
      ],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/notion-predator"
      }
    },
    "revenuecat-predator": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.revenuecat.ai/mcp",
        "22235"
      ],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/revenuecat-predator"
      }
    },
    "aws-predator": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile",
        "AdministratorAccess-225647925102",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ]
    },
    "customerio-predator": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.customer.io/mcp",
        "22239"
      ],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "${userHome}/.mcp-auth/customerio-predator"
      }
    }
  }
}
